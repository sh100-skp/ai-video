# 이 파일을 .env 로 복사한 뒤 값을 바꿔 사용하세요. (.env 는 외부에 공유하지 마세요)

# 관리자 비밀번호 (4자 이상, 필수 / 운영 시에는 길게 권장). 프런트엔드 코드에는 포함되지 않고 서버에서만 사용됩니다.
ADMIN_PASSWORD=change-me-please

# 로그인 유지용 서명 키 (임의의 긴 문자열). 설정하면 서버를 재시작해도 로그인이 유지됩니다.
SESSION_SECRET=

# 포트 (기본 3000)
PORT=3000

# 데이터베이스 파일 위치 (기본 ./data/planet-live.db). 배포 시 영구 저장소(볼륨) 경로로 지정하세요.
# DB_PATH=/data/planet-live.db

# 회사 HTTPS 프록시/로드밸런서 뒤에서 운영할 때
# NODE_ENV=production
# TRUST_PROXY=1
